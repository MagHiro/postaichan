{
  "name": "tempat-taichan-pos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/domain.test.ts tests/config-security.test.ts tests/midtrans-security.test.ts tests/http-security.test.ts",
    "test:db": "node --experimental-strip-types --test tests/database.integration.test.ts tests/menu-database.test.ts",
    "test:csp-smoke": "node scripts/csp-smoke.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.mjs",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "^16.3.8",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.6.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.2"
  }
}
