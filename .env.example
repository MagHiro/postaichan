# Development-only Compose credentials. Production uses this one DATABASE_URL for app traffic and migration/seed jobs.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/baranburn
DATABASE_DDL_ROLE=postaichan_ddl
APP_ORIGIN=http://localhost:3000
DATABASE_POOL_MAX=10
MIDTRANS_SERVER_KEY=server_only_midtrans_server_key
MIDTRANS_IS_PRODUCTION=false
# Choose none, trusted_header, or trusted_proxy. See README deployment notes.
CLIENT_IP_STRATEGY=none
# Set only when CLIENT_IP_STRATEGY=trusted_header and ingress overwrites the header.
# TRUSTED_CLIENT_IP_HEADER=x-vercel-forwarded-for
# Set only when CLIENT_IP_STRATEGY=trusted_proxy.
# TRUSTED_PROXY_HOPS=1
REQUIRE_ORDERING_QR=false
# Never enable this outside local development. Default is fail-closed.
ALLOW_DEV_STAFF_BYPASS=false
# Required by pnpm run db:seed; never commit it.
ADMIN_EMAIL=admin@baraburn.my.id
ADMIN_PASSWORD=choose-a-local-password-with-at-least-12-characters
