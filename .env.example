# Local development defaults match compose.yaml. Use a secret password outside local development.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/baranburn
# Optional separate URL used by migration/seed scripts when the app role is least-privileged.
# DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:55432/baranburn
MIDTRANS_SERVER_KEY=server_only_midtrans_server_key
MIDTRANS_IS_PRODUCTION=false
# Never enable this outside local development. Default is fail-closed.
ALLOW_DEV_STAFF_BYPASS=false
# Required by npm run db:seed; never commit it.
ADMIN_EMAIL=admin@baraburn.my.id
ADMIN_PASSWORD=choose-a-local-password-with-at-least-12-characters
