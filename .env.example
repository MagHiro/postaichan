NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Preferred for new Supabase projects. Keep server-only; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_server_only_key
# Legacy fallback if your project still uses the old key name.
# SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key
MIDTRANS_SERVER_KEY=server_only_midtrans_server_key
MIDTRANS_IS_PRODUCTION=false
# Never enable this outside local development. Default is fail-closed.
ALLOW_DEV_STAFF_BYPASS=false
